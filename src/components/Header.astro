---
import { siteBase } from "../lib/base";

const baseUrl = siteBase();
const basePath = baseUrl === "/" ? "" : baseUrl.replace(/\/+$/, "");

const path =
  Astro.url.pathname.replace(/\/+$/, "") === ""
    ? "/"
    : Astro.url.pathname.replace(/\/+$/, "");

const isHome = basePath === "" ? path === "/" : path === basePath;

function sectionActive(segment: string): boolean {
  const prefix =
    basePath === "" ? `/${segment}` : `${basePath}/${segment}`;
  return path === prefix || path.startsWith(`${prefix}/`);
}

const links = [
  { href: baseUrl, label: "Accueil", active: isHome },
  { href: `${baseUrl}offre/`, label: "Offre", active: sectionActive("offre") },
  {
    href: `${baseUrl}methode/`,
    label: "Méthode",
    active: sectionActive("methode"),
  },
  {
    href: `${baseUrl}a-propos/`,
    label: "À propos",
    active: sectionActive("a-propos"),
  },
  { href: `${baseUrl}contact/`, label: "Contact", active: sectionActive("contact") },
];
---

<header
  style="border-bottom: 1px solid var(--color-border); background: var(--color-surface);"
>
  <div
    style="max-width: 56rem; margin: 0 auto; padding: 1rem 1.5rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem;"
  >
    <a
      href={baseUrl}
      style="color: var(--color-text); text-decoration: none; font-weight: 500; letter-spacing: -0.02em;"
    >
      Aeschbacher Conseil
    </a>
    <nav aria-label="Navigation principale">
      <ul
        style="list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 1rem 1.25rem;"
      >
        {
          links.map(({ href, label, active }) => (
            <li>
              <a
                href={href}
                aria-current={active ? "page" : undefined}
                style={
                  active
                    ? "color: var(--color-text); text-decoration: none; font-weight: 500;"
                    : "color: var(--color-text-muted); text-decoration: none;"
                }
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
