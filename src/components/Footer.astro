---
const year = new Date().getFullYear();
---

<footer
  style="border-top: 1px solid var(--color-border); background: var(--color-surface); margin-top: auto;"
>
  <div
    style="max-width: 56rem; margin: 0 auto; padding: 2rem 1.5rem; font-size: 0.9rem; color: var(--color-text-muted);"
  >
    <p style="margin: 0 0 0.5rem;">
      © {year} Aeschbacher Conseil — Structuration & communication pour TPE et PME.
    </p>
    <p style="margin: 0;">
      Tarifs sur devis. Aucune adresse publique (contact via formulaire ou WhatsApp).
    </p>
  </div>
</footer>
