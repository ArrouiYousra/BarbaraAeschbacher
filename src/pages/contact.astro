---
import Layout from "../layouts/Layout.astro";

/** Remplacez par votre lien Formspree (https://formspree.io) ou autre endpoint — GitHub Pages ne traite pas les formulaires seul. */
const FORMSPREE_ACTION = "https://formspree.io/f/REMPLACER";

/** Numéro international sans espaces, ex. 33612345678 — lien wa.me */
const WHATSAPP_E164 = "33600000000";
const whatsappHref = `https://wa.me/${WHATSAPP_E164}`;
---

<Layout
  title="Contact"
  description="Formulaire de contact et WhatsApp — réponse sous devis, sans affichage de tarifs en ligne."
>
  <article class="prose">
    <p class="eyebrow">Écrire</p>
    <h1>Contact</h1>
    <p class="lead">
      Décrivez votre contexte et votre besoin : je reviens vers vous pour un échange et, le cas
      échéant, un devis. Aucun tarif public : chaque mission est cadrée individuellement.
    </p>

    <p>
      <a class="button" href={whatsappHref} rel="noopener noreferrer" target="_blank"
        >WhatsApp</a>
    </p>

    <h2>Formulaire</h2>
    <form action={FORMSPREE_ACTION} method="post">
      <label for="name">Nom</label>
      <input id="name" name="name" type="text" required autocomplete="name" />

      <label for="email">E-mail</label>
      <input id="email" name="email" type="email" required autocomplete="email" />

      <label for="message">Message</label>
      <textarea id="message" name="message" required></textarea>

      <input type="hidden" name="_subject" value="Message — Aeschbacher Conseil" />
      <button type="submit" class="button">Envoyer</button>
    </form>
  </article>
</Layout>
