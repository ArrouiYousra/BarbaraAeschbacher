---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteBase } from "../lib/base";
import "../styles/global.css";

const base = siteBase();

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Conseil en structuration et communication pour chefs d'entreprise TPE/PME." } =
  Astro.props;
const pageTitle = title.includes("Aeschbacher") ? title : `${title} — Aeschbacher Conseil`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link
      rel="icon"
      href={`${base}webassets/brand/sigle-01.png`}
      type="image/png"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="layout">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
